PANEL_USERNAME=admin
PANEL_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
EVENTS_API_TOKEN=REPLACE_WITH_THE_SAME_TOKEN_AS_BOT
# Вариант 1: машина бота доступна по SSH (без публичного порта API).
BOT_SSH_HOST=REPLACE_WITH_BOT_MACHINE_IP
BOT_SSH_USER=REPLACE_WITH_SSH_USER
BOT_SSH_PORT=22
# Реальное многострочное содержимое закрытого ключа, НЕ путь к файлу.
BOT_SSH_PRIVATE_KEY=REPLACE_IN_RAILWAY_VARIABLES
# Строка known_hosts для этого IP (проверенный SSH host key).
BOT_SSH_KNOWN_HOSTS=REPLACE_IN_RAILWAY_VARIABLES
# Вариант 2: без SSH, если уже есть публичный HTTPS API. Удалите BOT_SSH_*.
# BOT_API_URL=https://bot-api.example.com
